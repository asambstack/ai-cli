# ═══════════════════════════════════════════════════════════════
# O11Y — Containerized (manual trigger)
# ═══════════════════════════════════════════════════════════════

if profile in ['full', 'o11y']:
  # Generate docker-compose with correct paths
  local('bash ' + DEVENV + '/generate-compose.sh')
  local('docker rm -f tilt-o11y-ingest tilt-o11y-consumer tilt-o11y-logproxy tilt-o11y-preprocessor tilt-o11y-api tilt-context-generator tilt-llm-service 2>/dev/null || true')
  docker_compose(DEVENV + '/docker-compose.generated.yml', project_name='devenv')

  dc_resource('o11y-ingest',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    links=[link('#', 'REQUIRED — receives test events via HTTP, pushes to Kafka')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

  dc_resource('o11y-consumer',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    links=[link('#', 'REQUIRED — reads Kafka, writes to PostgreSQL + Elasticsearch')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

  dc_resource('o11y-logproxy',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    links=[link('#', 'OPTIONAL — proxies log downloads from S3 (only for "view logs")')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

  dc_resource('o11y-preprocessor',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    links=[link('#', 'OPTIONAL — enriches events (quality gates, notifications)')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

  dc_resource('o11y-api',
    labels=['o11y'],
    resource_deps=['postgresql', 'elasticsearch', 'redis'],
    links=[link('http://localhost:8085', 'REQUIRED — REST API for the new frontend dashboard')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

