# ═══════════════════════════════════════════════════════════════
# Automate E2E — Local Development Environment
# Source: ~/.ai-agents-repo/devenv/Tiltfile
# Symlinked to: ~/development/Tiltfile
# Run: cd ~/development && tilt up
# UI:  http://localhost:10350
# ═══════════════════════════════════════════════════════════════

DEV = '/Users/aditya/development'
DEVENV = os.environ.get('HOME', '/Users/aditya') + '/.ai-agents-repo/devenv'
NVM_DIR = '/Users/aditya/.nvm/versions/node'
KAFKA_HOME = DEV + '/kafka/kafka_2.12-2.7.0'

# ─── Path helpers per Node version ────────────────────────────
BASE_PATH = '/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'

def node_env(version):
  return {'PATH': NVM_DIR + '/' + version + '/bin:' + BASE_PATH}

NODE16_ENV = node_env('v16.20.2')
NODE18_ENV = node_env('v18.12.1')
NODE20_ENV = node_env('v20.17.0')
NODE22_ENV = node_env('v22.15.0')

RVM_RAILS_BIN = '/Users/aditya/.rvm/gems/ruby-2.6.6@rails602/bin:/Users/aditya/.rvm/gems/ruby-2.6.6@global/bin:/Users/aditya/.rvm/rubies/ruby-2.6.6/bin:/Users/aditya/.rvm/bin'
RAILS_ENV = {
  'PATH': RVM_RAILS_BIN + ':' + BASE_PATH,
  'GEM_HOME': '/Users/aditya/.rvm/gems/ruby-2.6.6@rails602',
  'GEM_PATH': '/Users/aditya/.rvm/gems/ruby-2.6.6@rails602:/Users/aditya/.rvm/gems/ruby-2.6.6@global',
  'RAILS_ENV': 'development',
}

def copy_if_missing(src, dst):
  return 'test -f ' + dst + ' || cp ' + src + ' ' + dst

# ─── Config ───────────────────────────────────────────────────
config.define_string('profile', args=True)
cfg = config.parse()
profile = cfg.get('profile', 'full')

# ═══════════════════════════════════════════════════════════════
# SETUP — Manual triggers for first-time repo setup
# ═══════════════════════════════════════════════════════════════

local_resource('setup-seleniumhub',
  cmd='''
    cd ''' + DEV + '''/seleniumhub &&
    ''' + copy_if_missing('conf.json.sample', 'conf.json') + ''' &&
    export PATH="''' + NVM_DIR + '''/v16.20.2/bin:$PATH" &&
    npm install &&
    echo "seleniumhub setup complete"
  ''',
  labels=['setup'],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)

