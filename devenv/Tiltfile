# ═══════════════════════════════════════════════════════════════
# CONTEXT GENERATOR — Containerized (manual trigger)
# ═══════════════════════════════════════════════════════════════

if profile in ['full', 'tcg']:
  if profile not in ['o11y']:
    local('bash ' + DEVENV + '/generate-compose.sh')
    local('docker rm -f tilt-context-generator tilt-llm-service 2>/dev/null || true')
    docker_compose(DEVENV + '/docker-compose.generated.yml', project_name='devenv')

  dc_resource('context-generator',
    labels=['misc'],
    links=[link('http://localhost:3005', 'AI test case generation server')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )

  dc_resource('llm-service',
    labels=['misc'],
    links=[link('#', 'LLM backend for context generator (OpenAI/Azure)')],
    trigger_mode=TRIGGER_MODE_MANUAL, auto_init=False,
  )
