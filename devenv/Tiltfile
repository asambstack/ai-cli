# ═══════════════════════════════════════════════════════════════
# O11Y — Containerized (manual trigger)
# ═══════════════════════════════════════════════════════════════

if profile in ['full', 'o11y']:
  local('docker rm -f tilt-o11y-ingest tilt-o11y-consumer tilt-o11y-logproxy tilt-o11y-preprocessor tilt-o11y-api tilt-context-generator tilt-llm-service 2>/dev/null || true')
  docker_compose(DEVENV + '/docker-compose.yml', project_name='devenv')

  dc_resource('o11y-ingest',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
  )

  dc_resource('o11y-consumer',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
  )

  dc_resource('o11y-logproxy',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
  )

  dc_resource('o11y-preprocessor',
    labels=['o11y'],
    resource_deps=['kafka', 'postgresql', 'elasticsearch'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
  )

  dc_resource('o11y-api',
    labels=['o11y'],
    resource_deps=['postgresql', 'elasticsearch', 'redis'],
    links=['http://localhost:8085'],
    trigger_mode=TRIGGER_MODE_MANUAL,
    auto_init=False,
  )

