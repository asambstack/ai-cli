  serve_cmd='node hub.js',
  serve_dir=DEV + '/seleniumhub',
  serve_env=NODE16_ENV,
  readiness_probe=probe(tcp_socket=tcp_socket_action(port=8080), period_secs=5, timeout_secs=3, initial_delay_secs=5),
  resource_deps=['redis', 'kafka', 'railsapp'],
  links=[link('http://localhost:8080', 'Selenium Hub — routes test sessions to browsers')],
  labels=['core'],
)

local_resource('timeout-manager',
  serve_cmd='node apps/timeoutManager/run.js',
  serve_dir=DEV + '/seleniumhub',
  serve_env=NODE16_ENV,
  resource_deps=['redis', 'seleniumhub'],
  links=[link('#', 'Manages idle session timeouts via Redis')],
  labels=['core'],
)

local_resource('kafka-uploader-raw',
  serve_cmd='CONSUMER_ID=1 CONSUMER_TOPIC=raw_logs node kafkaUploaderRun.js',
