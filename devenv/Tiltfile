local_resource('railsapp',
  serve_cmd='while true; do sleep 3600; done',
  readiness_probe=probe(tcp_socket=tcp_socket_action(port=443, host='local.bsstag.com'), period_secs=10, timeout_secs=3),
  resource_deps=['mysql', 'redis'],
  links=[link('https://local.bsstag.com', 'Rails App — external, managed by nginx/passenger')],
  labels=['core'],
)

